# Copy to .env and fill in. .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-WITH-YOUR-OWN-KEY

# Provider / model. claude-sonnet-4-5 is the accuracy/cost sweet spot for extraction.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929

# DEMO_MODE=1 replays committed LLM responses from data/llm_cache/ and never calls the
# API. This is what the deployed app and the notebook run under: the demo works with
# no key, no network, and no cost. Set to 0 only to (re)parse documents live.
DEMO_MODE=1

# Optional subsystems. All default on; the core demo must still run with all of them
# off (asserted by tests/test_flags.py).
ENABLE_SEMANTIC=1
ENABLE_LLM_QUERY=1
ENABLE_COUNTERFACTUALS=1
ENABLE_INJECTION_SCAN=1
ENABLE_SYNTHETIC=1
BLIND_REVIEW=0
